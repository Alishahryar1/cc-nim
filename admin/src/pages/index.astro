---
import '../styles/app.css';
import Sidebar from '../components/Sidebar.svelte';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Free Claude Code - Admin</title>
    <link rel="icon" type="image/svg+xml" href="/admin/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="h-full antialiased text-[var(--color-text-primary)]">
    <div class="flex h-full" id="app">
      <Sidebar client:load activeView="providers" collapsed={false} onViewChange={(id) => setActiveView(id)} />

      <div class="flex flex-1 flex-col min-w-0 bg-[var(--color-bg-surface)]">
        <!-- Header -->
        <header class="flex items-center justify-between px-6 h-14 shrink-0 border-b border-[var(--color-border-subtle)]">
          <div class="flex items-center gap-3">
            <h2 id="pageTitle" class="text-base font-semibold" style="font-family:var(--font-display)">Providers</h2>
          </div>
          <span id="dirtyState" class="text-xs text-[var(--color-text-muted)]">No changes</span>
        </header>

        <!-- Main -->
        <main id="mainContent" class="flex-1 overflow-y-auto">
          <!-- Loading skeleton -->
          <div id="loading" class="p-6 space-y-4">
            <div class="flex gap-4">
              <div class="flex-1 h-24 rounded-xl bg-[var(--color-bg-elevated)] animate-pulse"></div>
              <div class="flex-1 h-24 rounded-xl bg-[var(--color-bg-elevated)] animate-pulse"></div>
              <div class="flex-1 h-24 rounded-xl bg-[var(--color-bg-elevated)] animate-pulse"></div>
            </div>
            <div class="grid grid-cols-3 gap-4">
              <div class="h-32 rounded-xl bg-[var(--color-bg-elevated)] animate-pulse"></div>
              <div class="h-32 rounded-xl bg-[var(--color-bg-elevated)] animate-pulse"></div>
              <div class="h-32 rounded-xl bg-[var(--color-bg-elevated)] animate-pulse"></div>
            </div>
          </div>

          <!-- Content (hidden until loaded) -->
          <div id="content" class="p-6 space-y-6" style="display:none">
            <div id="statsBar" class="grid grid-cols-1 md:grid-cols-3 gap-4"></div>

            <section id="view-providers" class="admin-view" data-view="providers">
              <div id="providerGridContainer"></div>
              <div id="providersSections" class="space-y-4"></div>
            </section>

            <section id="view-model_config" class="admin-view" data-view="model_config" style="display:none">
              <div id="modelConfigSections" class="space-y-4"></div>
            </section>

            <section id="view-messaging" class="admin-view" data-view="messaging" style="display:none">
              <div id="messagingSections" class="space-y-4"></div>
            </section>
          </div>
        </main>

        <!-- Footer -->
        <footer class="flex items-center justify-between px-6 h-14 shrink-0 border-t border-[var(--color-border-subtle)] bg-[var(--color-bg-elevated)]">
          <div class="flex items-center gap-3 flex-1 min-w-0">
            <button id="configPath" type="button" class="text-xs font-mono text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] truncate max-w-md cursor-pointer"></button>
            <span id="versionInfo" class="text-xs text-[var(--color-text-muted)] font-mono"></span>
          </div>
          <div id="messageArea" class="text-xs text-[var(--color-text-muted)] text-center flex-1 min-w-0"></div>
          <div class="flex items-center gap-2 shrink-0">
            <button id="validateBtn" class="h-8 px-3 rounded-md text-xs font-medium border border-[var(--color-border-subtle)] hover:bg-[var(--color-bg-hover)] transition-colors" type="button">Validate</button>
            <button id="applyBtn" class="h-8 px-3 rounded-md text-xs font-medium bg-[var(--color-accent)] text-white hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed transition-opacity" type="button" disabled>Apply</button>
          </div>
        </footer>

        <!-- Toast container -->
        <div id="toastContainer" class="fixed bottom-6 right-6 flex flex-col gap-2 z-50 pointer-events-none"></div>
      </div>
    </div>
  </body>
</html>

<script>
  import { loadConfig, validateConfig, applyConfig, loadLocalStatus } from '../lib/api';
  import { VIEW_GROUPS, MASKED_SECRET } from '../lib/config';

  let config, fields, sections, providerStatus;

  const $ = (id) => document.getElementById(id);

  function readValue(el) {
    if (el.type === 'checkbox') return el.checked ? 'true' : 'false';
    if (el.dataset.secret === 'true' && el.dataset.configured === 'true') return el.value || MASKED_SECRET;
    return el.value;
  }

  function changedValues() {
    const vals = {};
    document.querySelectorAll('[data-key]').forEach(el => {
      if (el.disabled || !el.matches('input, select, textarea')) return;
      const v = readValue(el);
      if (v !== el.dataset.original) vals[el.dataset.key] = v;
    });
    return vals;
  }

  function markDirty() {
    const n = Object.keys(changedValues()).length;
    const el = $('dirtyState');
    el.textContent = n === 0 ? 'No changes' : `${n} unsaved change${n === 1 ? '' : 's'}`;
    el.className = `text-xs ${n === 0 ? 'text-[var(--color-text-muted)]' : 'text-amber-500 font-semibold'}`;
    $('applyBtn').disabled = n === 0;
  }

  function setActiveView(viewId) {
    const view = VIEW_GROUPS.find(v => v.id === viewId) || VIEW_GROUPS[0];
    $('pageTitle').textContent = view.title;
    document.querySelectorAll('.admin-view').forEach(v => {
      v.style.display = v.dataset.view === view.id ? '' : 'none';
    });
    $('mainContent').scrollTop = 0;
  }

  function message(msg, cls = 'text-[var(--color-text-muted)]') {
    const el = $('messageArea');
    el.textContent = msg;
    el.className = `text-xs text-center flex-1 min-w-0 ${cls}`;
  }

  function toast(msg, type = 'info', duration = 4000) {
    const c = $('toastContainer');
    const t = document.createElement('div');
    t.className = `flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-medium pointer-events-auto shadow-lg border ${
      type === 'success' ? 'bg-emerald-900/80 text-emerald-300 border-emerald-700/30' :
      type === 'error' ? 'bg-rose-900/80 text-rose-300 border-rose-700/30' :
      'bg-[var(--color-bg-elevated)] text-[var(--color-text-primary)] border-[var(--color-border-subtle)]'
    }`;
    t.textContent = msg;
    const close = document.createElement('button');
    close.innerHTML = '&times;';
    close.className = 'ml-2 text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]';
    close.onclick = () => t.remove();
    t.appendChild(close);
    c.appendChild(t);
    setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, duration);
  }

  function showValidation(r) {
    if (r.valid) { message('Config is valid', 'text-emerald-500'); toast('Config is valid', 'success'); }
    else { message(r.errors.join('; '), 'text-rose-500'); toast(r.errors.join('; '), 'error', 6000); }
  }

  async function validate(show = true) {
    const r = await validateConfig(changedValues());
    if (show) showValidation(r);
    return r;
  }

  async function apply() {
    const r = await applyConfig(changedValues());
    if (!r.applied) { showValidation(r); return; }
    const restart = r.restart || {};
    if (restart.required && restart.automatic) {
      toast('Applied. Restarting...', 'success');
      message('Applied. Restarting...', 'text-emerald-500');
      $('applyBtn').disabled = true;
      setTimeout(() => { window.location.href = restart.admin_url || '/admin'; }, 1600);
      return;
    }
    const pending = restart.required ? restart.fields || [] : r.pending_fields || [];
    await load();
    const m = pending.length ? `Applied. Restart needed for: ${pending.join(', ')}` : 'Applied';
    message(m, 'text-emerald-500');
    toast(m, 'success');
  }

  // ── Rendering ──

  function renderStats(providers) {
    const total = providers.length;
    const configured = providers.filter(p => ['configured', 'reachable', 'running'].includes(p.status)).length;
    const online = providers.filter(p => ['reachable', 'running'].includes(p.status)).length;
    $('statsBar').innerHTML = `
      <div class="p-4 rounded-xl bg-[var(--color-bg-elevated)] border border-[var(--color-border-subtle)]">
        <div class="text-2xl font-bold" style="font-family:var(--font-display)">${total}</div>
        <div class="text-xs text-[var(--color-text-muted)] mt-1">Adapters</div>
      </div>
      <div class="p-4 rounded-xl bg-[var(--color-bg-elevated)] border border-[var(--color-border-subtle)]">
        <div class="text-2xl font-bold text-emerald-500" style="font-family:var(--font-display)">${configured}</div>
        <div class="text-xs text-[var(--color-text-muted)] mt-1">Configured</div>
      </div>
      <div class="p-4 rounded-xl bg-[var(--color-bg-elevated)] border border-[var(--color-border-subtle)]">
        <div class="text-2xl font-bold text-[var(--color-accent)]" style="font-family:var(--font-display)">${online}</div>
        <div class="text-xs text-[var(--color-text-muted)] mt-1">Online</div>
      </div>
    `;
  }

  function renderProviders(providers) {
    const c = $('providerGridContainer');
    c.innerHTML = '';
    const wrap = document.createElement('div');
    wrap.className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3';

    const names = { nvidia_nim: 'NVIDIA NIM', open_router: 'OpenRouter', mistral_codestral: 'Mistral Codestral', deepseek: 'DeepSeek', lmstudio: 'LM Studio', llamacpp: 'llama.cpp', ollama: 'Ollama', kimi: 'Kimi', wafer: 'Wafer', opencode: 'OpenCode Zen', opencode_go: 'OpenCode Go', zai: 'Z.ai' };

    providers.forEach(p => {
      const card = document.createElement('div');
      card.className = 'p-4 rounded-xl bg-[var(--color-bg-elevated)] border border-[var(--color-border-subtle)]';
      card.dataset.provider = p.provider_id;

      const name = names[p.provider_id] || p.provider_id.split('_').map(s => s[0].toUpperCase() + s.slice(1)).join(' ');

      const statusOk = ['configured', 'reachable', 'running'].includes(p.status);
      const statusWarn = ['missing_key', 'missing_url', 'unknown'].includes(p.status);

      card.innerHTML = `
        <div class="flex items-center justify-between mb-2">
          <strong class="text-sm font-semibold">${name}</strong>
          <span class="text-xs px-2 py-0.5 rounded-md font-medium border ${
            statusOk ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' :
            statusWarn ? 'bg-amber-500/10 text-amber-400 border-amber-500/20' :
            'bg-rose-500/10 text-rose-400 border-rose-500/20'
          }">${p.label}</span>
        </div>
        <div class="text-xs font-mono text-[var(--color-text-muted)] truncate mb-3">${p.kind === 'local' ? (p.base_url || '—') : p.credential_env}</div>
        <button type="button" class="test-btn w-full h-7 rounded-lg text-xs font-medium border border-[var(--color-border-subtle)] bg-[var(--color-bg-base)] hover:bg-[var(--color-bg-hover)] transition-colors" data-provider="${p.provider_id}" data-kind="${p.kind}" data-name="${name}">${p.kind === 'local' ? 'Test' : 'Refresh'}</button>
      `;

      card.querySelector('.test-btn').addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        btn.disabled = true;
        btn.textContent = '...';
        try {
          const res = await (await fetch(`/admin/api/providers/${p.provider_id}/test`, { method: 'POST', body: '{}', headers: { 'Content-Type': 'application/json' } })).json();
          if (res.ok) {
            const models = (res.models || []).slice(0, 3).join(', ') || 'Connected';
            const pill = card.querySelector('span');
            pill.className = 'text-xs px-2 py-0.5 rounded-md font-medium border bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
            pill.textContent = `${res.models.length} models`;
            card.querySelector('.text-xs.font-mono').textContent = models;
            toast(`${name}: ${res.models.length} models`, 'success');
          } else {
            const pill = card.querySelector('span');
            pill.className = 'text-xs px-2 py-0.5 rounded-md font-medium border bg-rose-500/10 text-rose-400 border-rose-500/20';
            pill.textContent = res.error_type || 'Error';
            toast(`${name}: ${res.error_type}`, 'error');
          }
        } catch { toast(`Test failed for ${name}`, 'error'); }
        finally { btn.disabled = false; btn.textContent = p.kind === 'local' ? 'Test' : 'Refresh'; }
      });

      wrap.appendChild(card);
    });

    c.appendChild(wrap);
  }

  function renderSections() {
    VIEW_GROUPS.forEach(v => { const el = $(v.containerId); if (el) el.innerHTML = ''; });

    const bySec = new Map();
    sections.forEach(s => bySec.set(s.id, []));
    fields.forEach(f => { if (!bySec.has(f.section)) bySec.set(f.section, []); bySec.get(f.section).push(f); });

    VIEW_GROUPS.forEach(view => {
      const container = $(view.containerId);
      if (!container) return;
      view.sections.forEach(sid => {
        const sec = sections.find(s => s.id === sid);
        const secFields = bySec.get(sid) || [];
        if (!sec || !secFields.length) return;
        const el = document.createElement('section');
        el.className = 'p-5 rounded-xl bg-[var(--color-bg-elevated)] border border-[var(--color-border-subtle)]';
        el.innerHTML = `<div class="pb-3 mb-4 border-b border-[var(--color-border-subtle)]"><h3 class="text-sm font-semibold">${sec.label}</h3><p class="text-xs text-[var(--color-text-muted)] mt-0.5">${sec.description}</p></div><div class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>`;
        const grid = el.querySelector('.grid');
        secFields.forEach(f => grid.appendChild(renderField(f)));
        if (secFields.some(f => f.advanced)) {
          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'text-xs text-[var(--color-text-muted)] hover:text-[var(--color-accent)] mt-3';
          toggle.textContent = 'Advanced';
          toggle.onclick = () => { const show = el.classList.toggle('show-advanced'); toggle.textContent = show ? 'Hide advanced' : 'Advanced'; };
          el.appendChild(toggle);
        }
        container.appendChild(el);
      });
    });
  }

  function renderField(f) {
    const w = document.createElement('div');
    w.className = `flex flex-col gap-1.5 ${f.advanced ? 'advanced' : ''}`;
    w.dataset.key = f.key;

    const label = document.createElement('label');
    label.className = 'flex items-center justify-between text-xs font-medium text-[var(--color-text-secondary)]';
    label.htmlFor = `f-${f.key}`;
    label.innerHTML = `<span>${f.label}</span>`;

    const srcParts = [];
    const srcLabels = { default: 'default', template: 'template', repo_env: 'repo .env', managed_env: '', explicit_env_file: 'FCC_ENV_FILE', process: 'process env' };
    const sl = Object.prototype.hasOwnProperty.call(srcLabels, f.source) ? srcLabels[f.source] : f.source;
    if (sl) srcParts.push(sl);
    if (f.locked) srcParts.push('locked');
    if (srcParts.length) {
      const badge = document.createElement('span');
      badge.className = 'text-[10px] font-mono px-1.5 py-0.5 rounded border border-[var(--color-border-subtle)] bg-[var(--color-bg-base)] text-[var(--color-text-muted)]';
      badge.textContent = srcParts.join(' ');
      label.appendChild(badge);
    }

    let input;
    const baseCls = 'w-full h-8 px-3 text-xs bg-[var(--color-bg-base)] text-[var(--color-text-primary)] border border-[var(--color-border-subtle)] rounded-lg focus:outline-none focus:border-[var(--color-accent)] disabled:opacity-50';

    if (f.type === 'boolean') {
      const sw = document.createElement('label');
      sw.className = 'relative inline-flex items-center cursor-pointer w-9 h-5';
      input = document.createElement('input');
      input.type = 'checkbox';
      input.className = 'sr-only peer';
      input.checked = String(f.value).toLowerCase() === 'true';
      input.dataset.original = input.checked ? 'true' : 'false';
      const track = document.createElement('div');
      track.className = 'absolute inset-0 rounded-full bg-zinc-700 peer-checked:bg-[var(--color-accent)] transition-colors after:content-[""] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-4';
      sw.append(input, track);
      w.append(label, sw);
    } else {
      if (f.type === 'tri_boolean') {
        input = document.createElement('select'); input.className = baseCls;
        [['', 'Inherit'], ['true', 'Enabled'], ['false', 'Disabled']].forEach(([v, l]) => { const o = document.createElement('option'); o.value = v; o.textContent = l; if (v === (f.value || '')) o.selected = true; input.appendChild(o); });
      } else if (f.type === 'select') {
        input = document.createElement('select'); input.className = baseCls;
        (f.options || []).forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; if (v === f.value) o.selected = true; input.appendChild(o); });
      } else if (f.type === 'textarea') {
        input = document.createElement('textarea'); input.className = baseCls.replace('h-8', 'min-h-[64px]') + ' resize-y'; input.value = f.value || '';
      } else {
        input = document.createElement('input');
        input.className = baseCls;
        input.type = f.type === 'number' ? 'number' : (f.type === 'secret' ? 'password' : 'text');
        if (f.type === 'secret') { input.placeholder = f.configured ? '********' : ''; input.value = ''; input.autocomplete = 'off'; }
        else input.value = f.value || '';
      }
      input.id = `f-${f.key}`;
      input.dataset.key = f.key;
      input.dataset.original = f.value || '';
      input.dataset.secret = f.secret ? 'true' : 'false';
      input.dataset.configured = f.configured ? 'true' : 'false';
      input.disabled = f.locked;
      input.addEventListener('input', markDirty);
      input.addEventListener('change', markDirty);
      w.append(label, input);
    }

    if (f.description) {
      const d = document.createElement('div');
      d.className = 'text-[11px] text-[var(--color-text-muted)] leading-relaxed';
      d.textContent = f.description;
      w.appendChild(d);
    }
    return w;
  }

  function copyPath(path) {
    navigator.clipboard.writeText(path).then(() => {
      toast('Path copied', 'success', 2000);
      const el = $('configPath');
      const orig = el.innerHTML;
      el.innerHTML = '&#10003; Copied';
      setTimeout(() => el.innerHTML = orig, 1500);
    });
  }

  // ── Load ──

  async function load() {
    try {
      const cfg = await loadConfig();
      config = cfg;
      fields = cfg.fields;
      sections = cfg.sections;
      providerStatus = cfg.provider_status;

      renderStats(cfg.provider_status);
      renderProviders(cfg.provider_status);
      renderSections();

      const path = cfg.paths.managed;
      $('configPath').innerHTML = path;
      $('configPath').onclick = () => copyPath(path);
      $('versionInfo').textContent = `v${cfg.version || '?'}`;

      await validate(false);

      const statusRes = await loadLocalStatus();
      statusRes.providers.forEach(p => {
        const card = document.querySelector(`[data-provider="${p.provider_id}"]`);
        if (!card) return;
        const meta = p.status_code ? `HTTP ${p.status_code} - ${p.base_url}` : p.base_url;
        card.querySelector('.text-xs.font-mono').textContent = meta;
        const pill = card.querySelector('span');
        const isOk = ['reachable', 'configured', 'running'].includes(p.status);
        const isErr = ['offline', 'error'].includes(p.status);
        pill.className = `text-xs px-2 py-0.5 rounded-md font-medium border ${
          isOk ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' :
          isErr ? 'bg-rose-500/10 text-rose-400 border-rose-500/20' :
          'bg-amber-500/10 text-amber-400 border-amber-500/20'
        }`;
        pill.textContent = p.label;
      });

      markDirty();

      $('loading').style.display = 'none';
      $('content').style.display = '';
    } catch (err) {
      toast('Failed to load config', 'error', 8000);
      $('loading').innerHTML = '<div class="text-center py-12 text-[var(--color-text-muted)]">Failed to load admin config. <button onclick="location.reload()" class="text-[var(--color-accent)] underline">Reload</button></div>';
    }
  }

  // ── Init ──

  $('validateBtn').onclick = () => validate(true);
  $('applyBtn').onclick = apply;

  document.addEventListener('keydown', (e) => {
    const mod = e.metaKey || e.ctrlKey;
    if (mod && e.key.toLowerCase() === 's' && !$('applyBtn').disabled) { e.preventDefault(); apply(); }
    if (mod && e.key.toLowerCase() === 'k') { e.preventDefault(); validate(true); }
  });

  load();
</script>

<style is:global>
  @keyframes viewFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .admin-view { animation: viewFadeIn .25s ease; }
  .settings-section .advanced { display: none; }
  .settings-section.show-advanced .advanced { display: flex; }
</style>
